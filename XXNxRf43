    /* ═══════ PAGE COLLECTION — façon e-shop Yann Couvreur ═══════ */
    .collection-page { padding: 8rem 4vw 5rem; }
    .collection-page-inner.boutique { max-width: 1600px; margin: 0 auto; padding: 0; }
    .collection-page-inner.boutique::before { display: none; }

    /* ── Nav catégories horizontale ── */
    .collection-categories {
      display: flex;
      flex-wrap: wrap;
      gap: clamp(1.5rem, 3.5vw, 3.2rem);
      padding-bottom: 1.6rem;
      margin-bottom: 0;
    }
    .cat-tab {
      font-family: var(--sans);
      font-size: 0.66rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--ink-muted);
      background: none;
      border: none;
      padding: 0.2rem 0;
      cursor: pointer;
      position: relative;
      transition: color 0.35s var(--ease-out);
      white-space: nowrap;
    }
    .cat-tab::after {
      content: '';
      position: absolute;
      left: 0; bottom: -0.3rem;
      width: 0; height: 1.5px;
      background: var(--gold);
      transition: width 0.4s var(--ease-out);
    }
    .cat-tab:hover { color: var(--ink); }
    .cat-tab.active { color: var(--ink); }
    .cat-tab.active::after { width: 100%; }

    /* ── Barre compteur + filtre/tri ── */
    .collection-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.4rem 0;
      border-top: 1px solid rgba(26,22,18,0.1);
      border-bottom: 1px solid rgba(26,22,18,0.1);
      margin-bottom: 3rem;
    }
    .collection-count {
      font-family: var(--sans);
      font-size: 0.62rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ink);
    }
    .collection-sort { position: relative; }
    .sort-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      font-family: var(--sans);
      font-size: 0.62rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ink);
      background: none;
      border: none;
      cursor: pointer;
      transition: color 0.3s var(--ease-out);
    }
    .sort-toggle:hover { color: var(--gold); }
    .sort-menu {
      position: absolute;
      top: calc(100% + 0.9rem);
      right: 0;
      min-width: 220px;
      background: var(--white);
      border: 1px solid rgba(26,22,18,0.1);
      box-shadow: 0 18px 50px rgba(26,22,18,0.12);
      border-radius: 0.6rem;
      padding: 0.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px);
      transition: opacity 0.3s var(--ease-out), transform 0.3s var(--ease-out), visibility 0.3s;
      z-index: 50;
    }
    .sort-menu.open { opacity: 1; visibility: visible; transform: translateY(0); }
    .sort-menu button {
      font-family: var(--sans);
      font-size: 0.58rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--ink-muted);
      background: none;
      border: none;
      text-align: left;
      padding: 0.7rem 0.8rem;
      border-radius: 0.4rem;
      cursor: pointer;
      transition: background 0.25s, color 0.25s;
    }
    .sort-menu button:hover { background: rgba(163,120,27,0.07); color: var(--ink); }
    .sort-menu button.active { color: var(--gold); }

    /* ── Grille éditoriale asymétrique — 1ère carte visible en vedette ── */
    .shop-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 2.6rem 1.8rem;
      perspective: none;
    }
    .shop-grid .shop-card {
      grid-column: span 1;
      display: flex;
      flex-direction: column;
    }
    .shop-grid .shop-card .shop-card-img-wrap {
      aspect-ratio: 1;
      margin-bottom: 1rem;
    }
    /* Carte vedette : 2 colonnes × 2 rangées */
    .shop-grid .shop-card.is-featured {
      grid-column: span 2;
      grid-row: span 2;
    }
    .shop-grid .shop-card.is-featured .shop-card-img-wrap {
      aspect-ratio: auto;
      flex: 1;
      min-height: 0;
    }

    /* ── Typographie sans-serif unifiée façon Yann Couvreur ── */
    .cat-tab,
    .collection-count,
    .sort-toggle,
    .sort-menu button {
      font-family: var(--sans);
    }
    .cat-tab { font-weight: 300; }
    .collection-count,
    .sort-toggle { font-weight: 400; }
    /* Noms de produits — sans-serif uppercase letter-spacé (au lieu du serif) */
    .collection-page .shop-card-name {
      font-family: var(--sans);
      text-transform: uppercase;
      font-size: 0.9rem;
      font-weight: 300;
      letter-spacing: 0.13em;
      color: var(--ink);
      margin-bottom: 0.5rem;
    }
    .collection-page .shop-card-sub {
      font-family: var(--sans);
      text-transform: none;
      font-size: 0.78rem;
      font-weight: 300;
      letter-spacing: 0.01em;
      color: var(--ink-muted);
    }
    .shop-grid .shop-card.is-featured .shop-card-name {
      font-size: 1.25rem;
      letter-spacing: 0.1em;
    }

    @media (max-width: 1024px) {
      .shop-grid { grid-template-columns: repeat(3, 1fr); }
      .shop-grid .shop-card.is-featured { grid-column: span 2; grid-row: span 2; }
    }
    @media (max-width: 768px) {
      .collection-page { padding: 6.5rem 6vw 4rem; }
      .shop-grid { grid-template-columns: repeat(2, 1fr); gap: 2.2rem 1.3rem; }
      .shop-grid .shop-card.is-featured { grid-column: span 2; grid-row: span 1; }
      .shop-grid .shop-card.is-featured .shop-card-img-wrap { aspect-ratio: 16/10; flex: none; }
      .shop-grid .shop-card.is-featured .shop-card-name { font-size: 1.6rem; }
      .collection-bar { margin-bottom: 2rem; }
      .collection-categories { gap: 1.3rem; }
      .cat-tab { font-size: 0.58rem; letter-spacing: 0.14em; }
    }
