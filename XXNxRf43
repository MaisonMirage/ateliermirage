  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Reveal animations
      if (typeof gsap !== 'undefined') {
        gsap.from(".reveal", { opacity: 0, y: 30, duration: 1, stagger: 0.06, ease: "power3.out" });
      }
      // Page transition fade-in
      const transitionLayer = document.querySelector('.page-transition');
      if (transitionLayer && typeof gsap !== 'undefined') {
        gsap.to(transitionLayer, { opacity:0, duration:0.8, ease:"power2.inOut", onComplete:()=>{ transitionLayer.style.display='none'; }});
      }

      // ═══════ CATÉGORIES + TRI + CARTE VEDETTE + COMPTEUR ═══════
      const grid = document.querySelector('.shop-grid');
      const catTabs = document.querySelectorAll('.cat-tab');
      const countEl = document.getElementById('prodCount');
      const allCards = Array.from(document.querySelectorAll('.shop-card'));
      // Mémorise l'ordre original pour le tri "Mise en avant"
      allCards.forEach((c, i) => c.dataset.order = i);

      let currentFilter = 'all';
      let currentSort = 'default';

      const getCardName = (card) =>
        (card.querySelector('.shop-card-name')?.textContent || '').trim().toLowerCase();

      const render = () => {
        // 1. Filtrer
        const visible = allCards.filter(card =>
          currentFilter === 'all' || (card.dataset.cat || '').includes(currentFilter)
        );

        // 2. Trier
        if (currentSort === 'az') {
          visible.sort((a, b) => getCardName(a).localeCompare(getCardName(b)));
        } else if (currentSort === 'za') {
          visible.sort((a, b) => getCardName(b).localeCompare(getCardName(a)));
        } else {
          visible.sort((a, b) => (+a.dataset.order) - (+b.dataset.order));
        }

        // 3. Masquer tout, puis réafficher les visibles dans le bon ordre
        allCards.forEach(card => {
          card.style.display = 'none';
          card.classList.remove('is-featured');
        });
        visible.forEach((card, i) => {
          card.style.display = 'flex';
          grid.appendChild(card); // réordonne dans le DOM
          if (i === 0) card.classList.add('is-featured'); // 1ʳᵉ carte visible = vedette
        });

        // 4. Compteur
        if (countEl) countEl.textContent = visible.length;
      };

      // Clic sur une catégorie
      catTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          catTabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          currentFilter = tab.dataset.filter;
          render();
        });
      });

      // Menu de tri
      const sortToggle = document.getElementById('sortToggle');
      const sortMenu = document.getElementById('sortMenu');
      if (sortToggle && sortMenu) {
        sortToggle.addEventListener('click', (e) => {
          e.stopPropagation();
          const open = sortMenu.classList.toggle('open');
          sortToggle.setAttribute('aria-expanded', open);
        });
        sortMenu.querySelectorAll('button').forEach(btn => {
          btn.addEventListener('click', () => {
            sortMenu.querySelectorAll('button').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentSort = btn.dataset.sort;
            sortMenu.classList.remove('open');
            sortToggle.setAttribute('aria-expanded', 'false');
            render();
          });
        });
        document.addEventListener('click', (e) => {
          if (!e.target.closest('.collection-sort')) {
            sortMenu.classList.remove('open');
            sortToggle.setAttribute('aria-expanded', 'false');
          }
        });
      }

      // Lecture du filtre depuis l'URL (collection.html?filter=fruit)
      const urlFilter = new URLSearchParams(window.location.search).get('filter');
      const validFilters = ['all', 'fruit', 'chocolat', 'signature'];
      if (urlFilter && validFilters.includes(urlFilter)) {
        currentFilter = urlFilter;
        catTabs.forEach(t => t.classList.toggle('active', t.dataset.filter === urlFilter));
      }
      render();

      // Transitions de page sur liens internes — on exclut les cartes produit
      // (shop-modal.js les gère : modal sur desktop, navigation sur mobile)
      document.querySelectorAll('a').forEach(link => {
        if (link.classList.contains('shop-card')) return;
        link.addEventListener('click', function(e) {
          if (this.target==='_blank' || this.href.includes('#') || this.href.startsWith('mailto:') || this.href.startsWith('tel:') || this.hostname!==window.location.hostname) return;
          if (typeof gsap === 'undefined' || !transitionLayer) return;
          e.preventDefault();
          const targetUrl = this.href;
          transitionLayer.style.display = 'block';
          gsap.to(transitionLayer, { opacity:1, duration:0.5, ease:"power2.inOut", onComplete:()=>{ window.location.href=targetUrl; }});
        });
      });
    });

    // Navbar scroll state
    document.getElementById('navbar').classList.add('visible');
    window.addEventListener('scroll', () => {
      document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 60);
    });

    // Menu mobile
    const navBurger = document.getElementById('navBurger');
    const mobileOverlay = document.getElementById('mobile-overlay');
    if (navBurger && mobileOverlay) {
      navBurger.addEventListener('click', () => {
        mobileOverlay.classList.toggle('active');
        navBurger.classList.toggle('active');
        navBurger.setAttribute('aria-expanded', mobileOverlay.classList.contains('active'));
      });
      mobileOverlay.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          mobileOverlay.classList.remove('active');
          navBurger.classList.remove('active');
          navBurger.setAttribute('aria-expanded', 'false');
        });
      });
    }
  </script>
</body>
</html>
