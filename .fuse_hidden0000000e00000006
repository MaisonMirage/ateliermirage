  <style>
    main {
      display: flex; flex-direction: column; gap: 5rem;
      min-height: calc(100dvh - 100px);
      padding: 9rem 6vw 5rem; align-items: center;
    }

    /* HERO + INTRO */
    .content-side {
      width: 100%; max-width: 1100px; position: relative;
      text-align: center; display: flex; flex-direction: column; align-items: center;
    }

    .eyebrow {
      font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.3em;
      text-transform: uppercase; color: var(--gold); margin-bottom: 1.5rem;
    }

    h1 { font-family:var(--serif); font-size:clamp(3rem, 5vw, 5.2rem); font-weight:300; line-height:0.95; margin-bottom:2rem; letter-spacing:-0.02em; }
    h1 em { font-style:italic; color:var(--gold); }
    .description { font-family:var(--sans); font-size:1.05rem; line-height:1.8; color:var(--ink-muted); max-width:62ch; margin: 0 auto; }

    .hero-actions {
      display:flex; gap:1rem; flex-wrap:wrap; justify-content:center;
      margin-top: 2.5rem;
    }
    .btn-primary, .btn-ghost {
      display: inline-flex; align-items: center; gap: 0.6rem;
      font-family: var(--mono); font-size: 0.65rem; letter-spacing: 0.22em;
      text-transform: uppercase; padding: 1.1rem 2.4rem; border-radius: 999px;
      text-decoration: none; transition: all 0.4s var(--ease-spring);
    }
    .btn-primary { background: var(--ink); color: var(--cream); border: 1px solid var(--ink); }
    .btn-primary:hover { background: var(--gold); border-color: var(--gold); transform: translateY(-2px); }
    .btn-ghost { background: transparent; color: var(--ink); border: 1px solid rgba(26,23,20,0.2); }
    .btn-ghost:hover { border-color: var(--gold); color: var(--gold); transform: translateY(-2px); }

    .hero-img-wrapper {
      width: 100%; height: 50vh; min-height: 400px; max-height: 550px;
      border-radius: 2.5rem; overflow: hidden;
      box-shadow: 0 40px 80px rgba(26,23,20,0.08);
      margin: 3rem 0 0; border: 1px solid rgba(26,23,20,0.05);
    }
    .hero-img-wrapper img { width:100%; height:100%; object-fit:cover; transition:transform 1.2s cubic-bezier(0.2,0.8,0.2,1); }
    .hero-img-wrapper:hover img { transform:scale(1.04); }

    /* KPI MINI BAR */
    .kpi-mini {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 1px; background: rgba(26,23,20,0.06);
      border-radius: 1.5rem; overflow: hidden;
      width: 100%; max-width: 800px;
    }
    .kpi-mini-item { background: var(--cream); padding: 2rem 1.5rem; text-align: center; }
    .kpi-mini-num {
      font-family: var(--serif); font-size: clamp(1.6rem, 3vw, 2.2rem);
      font-weight: 300; color: var(--ink); line-height: 1; margin-bottom: 0.5rem;
    }
    .kpi-mini-num em { font-style: italic; color: var(--gold-light); }
    .kpi-mini-label {
      font-family: var(--mono); font-size: 0.5rem; letter-spacing: 0.2em;
      text-transform: uppercase; color: var(--ink-muted); line-height: 1.5;
    }

    /* SECTION HEADERS */
    .section-h2 {
      font-family: var(--serif); font-size: clamp(2.4rem, 4vw, 3.8rem);
      font-weight: 300; line-height: 1; letter-spacing: -0.01em;
      margin-bottom: 2rem; text-align: center;
    }
    .section-h2 em { font-style: italic; color: var(--gold); }
    .section-desc {
      font-family: var(--sans); font-size: 1rem; line-height: 1.8;
      color: var(--ink-muted); max-width: 60ch; margin: 0 auto 3rem;
      text-align: center;
    }

    /* HOW IT WORKS — 3 STEPS */
    .steps-list {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 4rem; width: 100%; text-align: left; margin-top: 1rem;
    }
    .step-item { position:relative; padding-top:2.5rem; border-top:1px solid rgba(26,23,20,0.1); }
    .step-item::before {
      content:''; position:absolute; left:0; top:-1px; width:40px; height:1px;
      background:var(--gold); transition:width 0.5s ease;
    }
    .step-item:hover::before { width: 100%; }
    .step-num {
      position:absolute; top:0.8rem; left:0;
      font-family:var(--mono); font-size:0.65rem; color:var(--gold); letter-spacing:0.1em;
    }
    .step-title { font-family:var(--serif); font-size:1.4rem; font-weight:400; color:var(--ink); margin-bottom:1rem; }
    .step-desc { font-family:var(--sans); font-size:0.9rem; color:var(--ink-muted); line-height:1.7; }

    /* COFFRETS — 3 CARDS */
    .coffrets-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.5rem; width: 100%;
    }
    .coffret-card {
      background: var(--white); border-radius: 1.5rem; padding: 2.5rem 2rem;
      border: 1px solid rgba(26,23,20,0.06); box-shadow: 0 4px 20px rgba(26,23,20,0.04);
      text-align: center; transition: transform 0.3s var(--ease-out), box-shadow 0.3s ease;
      display: flex; flex-direction: column;
    }
    .coffret-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(26,23,20,0.08); }
    .coffret-card.featured { background: var(--cream); border-color: rgba(168,137,92,0.2); }
    .coffret-eyebrow {
      font-family: var(--mono); font-size: 0.55rem; letter-spacing: 0.22em;
      text-transform: uppercase; color: var(--gold); margin-bottom: 1rem;
    }
    .coffret-name {
      font-family: var(--serif); font-size: 1.8rem; font-weight: 400;
      color: var(--ink); margin-bottom: 0.5rem;
    }
    .coffret-price {
      font-family: var(--serif); font-size: 2.4rem; font-weight: 300;
      color: var(--gold); margin-bottom: 1.5rem; font-style: italic;
    }
    .coffret-price span {
      font-family: var(--mono); font-size: 0.65rem; letter-spacing: 0.2em;
      text-transform: uppercase; color: var(--ink-muted); display: block;
      margin-top: 0.3rem; font-style: normal;
    }
    .coffret-desc {
      font-family: var(--sans); font-size: 0.9rem; color: var(--ink-muted);
      line-height: 1.7; margin-bottom: 2rem; flex-grow: 1;
    }

    /* CALENDAR — WEEK SCHEDULE */
    .calendar-list {
      width: 100%;
      border-top: 1px solid rgba(26,23,20,0.08);
    }
    .calendar-row {
      display: grid; grid-template-columns: 0.8fr 2fr 1fr;
      gap: 2rem; padding: 1.5rem 1rem;
      border-bottom: 1px solid rgba(26,23,20,0.08);
      align-items: center; transition: background 0.3s;
    }
    .calendar-row:hover { background: rgba(168,137,92,0.04); }
    .calendar-day {
      font-family: var(--serif); font-size: 1.3rem; font-weight: 400;
      color: var(--ink); font-style: italic;
    }
    .calendar-spot {
      font-family: var(--sans); font-size: 0.95rem; color: var(--ink); font-weight: 400;
    }
    .calendar-spot small {
      display: block; font-family: var(--mono); font-size: 0.55rem;
      letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-muted);
      margin-top: 0.3rem; font-weight: 400;
    }
    .calendar-time {
      font-family: var(--mono); font-size: 0.65rem; letter-spacing: 0.15em;
      text-transform: uppercase; color: var(--gold); text-align: right;
    }
    .calendar-row.rest { opacity: 0.55; }
    .calendar-row.rest .calendar-time { color: var(--ink-muted); }

    .calendar-note {
      font-family: var(--mono); font-size: 0.55rem; letter-spacing: 0.2em;
      text-transform: uppercase; color: var(--ink-muted); text-align: center;
      margin-top: 2rem; line-height: 1.8;
    }

    /* FAQ */
    .faq-list { width: 100%; max-width: 800px; }
    .faq-item {
      border-bottom: 1px solid rgba(26,23,20,0.08);
      padding: 1.8rem 0;
    }
    .faq-question {
      font-family: var(--serif); font-size: 1.2rem; font-weight: 400;
      color: var(--ink); margin-bottom: 0.8rem;
    }
    .faq-answer {
      font-family: var(--sans); font-size: 0.95rem; line-height: 1.7;
      color: var(--ink-muted);
    }

    /* WAITLIST FORM */
    .waitlist-side {
      width: 100%; max-width: 700px;
      background: var(--ink); color: var(--cream);
      border-radius: 2.5rem; padding: 4rem 3rem; text-align: center;
      position: relative; overflow: hidden;
    }
    .waitlist-side::before {
      content:''; position: absolute; top: -50%; left: -10%;
      width: 120%; height: 200%;
      background: radial-gradient(ellipse at center, rgba(168,137,92,0.18) 0%, transparent 60%);
      pointer-events: none;
    }
    .waitlist-side > * { position: relative; z-index: 2; }
    .waitlist-eyebrow {
      font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.3em;
      text-transform: uppercase; color: var(--gold-light); margin-bottom: 1.5rem;
    }
    .waitlist-title {
      font-family: var(--serif); font-size: clamp(2rem, 3.5vw, 3rem);
      font-weight: 300; line-height: 1; margin-bottom: 1.5rem; color: var(--cream);
    }
    .waitlist-title em { font-style: italic; color: var(--gold-light); }
    .waitlist-desc {
      font-family: var(--sans); font-size: 1rem; line-height: 1.7;
      color: rgba(250,245,239,0.7); max-width: 50ch; margin: 0 auto 2.5rem;
    }
    .waitlist-form {
      display: flex; gap: 0.6rem; max-width: 480px;
      margin: 0 auto; flex-wrap: wrap;
    }
    .waitlist-form input[type="email"] {
      flex: 1; min-width: 220px; padding: 1rem 1.4rem;
      font-family: var(--sans); font-size: 0.95rem; color: var(--cream);
      background: rgba(250,245,239,0.06); border: 1px solid rgba(250,245,239,0.15);
      border-radius: 999px; outline: none; transition: all 0.3s;
    }
    .waitlist-form input[type="email"]:focus {
      border-color: var(--gold-light); background: rgba(250,245,239,0.1);
    }
    .waitlist-form input[type="email"]::placeholder { color: rgba(250,245,239,0.4); }
    .waitlist-form button {
      padding: 1rem 1.8rem; font-family: var(--mono); font-size: 0.65rem;
      letter-spacing: 0.22em; text-transform: uppercase; color: var(--ink);
      background: var(--gold-light); border: 1px solid var(--gold-light);
      border-radius: 999px; cursor: pointer; transition: all 0.3s;
    }
    .waitlist-form button:hover { background: var(--cream); border-color: var(--cream); }

    .waitlist-success {
      display: none; padding-top: 1rem;
      font-family: var(--serif); font-style: italic; color: var(--gold-light);
    }
    .waitlist-success.active { display: block; }
    .waitlist-form.submitted { display: none; }

    .waitlist-privacy {
      font-family: var(--mono); font-size: 0.5rem; letter-spacing: 0.18em;
      text-transform: uppercase; color: rgba(250,245,239,0.4); margin-top: 1.5rem;
    }

    /* RESPONSIVE */
    @media (max-width: 1024px) {
      main { gap: 4rem; padding-top: 7rem; }
      .steps-list { grid-template-columns: 1fr; gap: 3rem; }
      .kpi-mini { grid-template-columns: 1fr; max-width: 100%; }
    }
    @media (max-width: 640px) {
      .calendar-row { grid-template-columns: 1fr; gap: 0.4rem; padding: 1.2rem 0.5rem; }
      .calendar-time { text-align: left; }
      .waitlist-side { padding: 3rem 1.5rem; }
      .hero-actions { flex-direction: column; width: 100%; max-width: 320px; }
      .btn-primary, .btn-ghost { justify-content: center; }
    }
  </style>
</head>
